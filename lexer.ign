import TokenKind from "token"

const PUNCTUATION = "+-".chars()

export struct Token {
	kind: string,
	value: any
}

export class Lexer {
	let pos = -1
	let cur_char

	constructor(self, text) {
		self.text = text
	}

	fn advance(self) {
		if ++self.pos < self.text.len() {
			return self.cur_char = self.text[self.pos]
		} else {
			return self.cur_char = nil
		}
	}

	fn token_from(value) {
		new Token {
			kind: Lexer::identify(value),
			value
		}
	}

	fn get_tokens(self) {
		let tokens = []
		let cur_token = ""

		while self.advance() {
			if self.cur_char == " " {
				if cur_token.len() > 0 {
					tokens.push(Lexer::token_from(cur_token))
					cur_token = ""
				}

				continue
			}

			if PUNCTUATION.contains(self.cur_char) {
				if cur_token.len() > 0 {
					tokens.push(Lexer::token_from(cur_token))
					cur_token.clear()
				}

					tokens.push(Lexer::token_from(self.cur_char))
			} else {
				cur_token += self.cur_char
			}
		}

		if cur_token.len() > 0 {
			tokens.push(Lexer::token_from(cur_token))
		}

		return tokens
	}

	fn identify(value) {
		match value {
			"+" => TokenKind::PLUS,
			"-" => TokenKind::MINUS,

			other => Lexer::identify_other(other)
		}
	}

	fn identify_other(value) {
		TokenKind::Identifier
	}
}
