import TokenKind from "token"

const PUNCTUATION = "+-".chars()

export struct Token {
	kind: TokenKind,
	value: any
}

export class Lexer {
	let pos = -1
	let cur_char

	constructor(self, text) {
		self.text = text
	}

	fn advance(self) {
		if ++self.pos < self.text.len() {
			self.cur_char = self.text[self.pos]
		} else {
			self.cur_char = nil
		}
	}

	fn get_tokens(self) {
		let tokens = []
		let cur_token = ""

		while self.advance() {
			if self.cur_char == " " {
				continue
			}

			if PUNCTUATION.contains(self.cur_char) {

			}
		}
	}
}
